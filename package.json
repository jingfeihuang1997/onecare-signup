{
  "name": "onecare-signup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build && node scripts/pages-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
